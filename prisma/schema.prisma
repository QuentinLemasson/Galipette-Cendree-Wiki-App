generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
  directUrl = env("DB_URL")
  relationMode = "foreignKeys"
}

model Article {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  path      String   @unique
  metadata  Json     @default("{}")
  folderId  Int?     @map("folder_id")
  folder    Folder?  @relation(fields: [folderId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  relatedToArticles   ArticleRelation[] @relation("ArticleToRelated")
  relatedFromArticles ArticleRelation[] @relation("RelatedToArticle")
  tags               ArticleTag[]

  @@map("articles")
  @@index([path, title])
  @@index([folderId])
}

model ArticleRelation {
  id                  Int      @id @default(autoincrement())
  articlePath         String   @map("article_path")
  relatedArticlePath  String   @map("related_article_path")
  
  article             Article  @relation("ArticleToRelated", fields: [articlePath], references: [path], onDelete: Cascade)
  relatedArticle      Article  @relation("RelatedToArticle", fields: [relatedArticlePath], references: [path], onDelete: Cascade)

  @@unique([articlePath, relatedArticlePath])
  @@index([articlePath])
  @@index([relatedArticlePath])
  @@map("article_relations")
}

model Tag {
  id           Int          @id @default(autoincrement())
  name         String       @unique
  articles     ArticleTag[]

  @@map("tags")
}

model ArticleTag {
  articlePath  String   @map("article_path")
  tagId       Int      @map("tag_id")
  article     Article  @relation(fields: [articlePath], references: [path], onDelete: Cascade)
  tag         Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articlePath, tagId])
  @@index([tagId])
  @@map("article_tags")
}

model Folder {
  id        Int      @id @default(autoincrement())
  name      String
  parentId  Int?     @map("parent_id")
  parent    Folder?  @relation("FolderToFolder", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[] @relation("FolderToFolder")
  articles  Article[]

  @@map("folders")
  @@index([parentId])
}

// TODO : refence the imported articles via foreign key
// TODO : both should reference the same commit hash
model ImportMetadata {
  id          Int      @id @default(autoincrement())
  filePath    String   @unique @map("file_path")
  fileHash    String   @map("file_hash")
  lastImport  DateTime @default(now()) @map("last_import")
  importCount Int      @default(1) @map("import_count")
  status      String   @default("success")
  error       String?
  metadata    Json     @default("{}")
  commitHash  String?  @map("commit_hash")
  gitStatus   String?  @map("git_status")

  @@map("import_metadata")
  @@index([filePath, fileHash])
  @@index([commitHash])
}

model GitImportLog {
  id            Int      @id @default(autoincrement())
  commitHash    String   @unique @map("commit_hash")
  importedAt    DateTime @default(now()) @map("imported_at")
  status        String   @default("success")
  error         String?
  filesChanged  Int      @default(0) @map("files_changed")
  metadata      Json     @default("{}")

  @@map("git_import_logs")
  @@index([commitHash])
} 