generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
  directUrl = env("DB_URL")
  relationMode = "foreignKeys"
}

model Article {
  id              Int       @id @default(autoincrement())
  title           String
  content         String
  path            String    @unique
  metadata        Json      @default("{}")
  folderId        Int?      @map("folder_id")
  folder          Folder?   @relation(fields: [folderId], references: [id])
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  relatedToArticles   ArticleRelation[] @relation("ArticleToRelated")
  relatedFromArticles ArticleRelation[] @relation("RelatedToArticle")
  tags                ArticleTag[]
  importMetadata      ImportMetadata?    @relation

  @@map("articles")
  @@index([path, title])
  @@index([folderId])
}

model ArticleRelation {
  id                  Int      @id @default(autoincrement())
  articlePath         String   @map("article_path")
  relatedArticlePath  String   @map("related_article_path")
  
  article             Article  @relation("ArticleToRelated", fields: [articlePath], references: [path], onDelete: Cascade)
  relatedArticle      Article  @relation("RelatedToArticle", fields: [relatedArticlePath], references: [path], onDelete: Cascade)

  @@unique([articlePath, relatedArticlePath])
  @@index([articlePath])
  @@index([relatedArticlePath])
  @@map("article_relations")
}

model Tag {
  id           Int          @id @default(autoincrement())
  name         String       @unique
  articles     ArticleTag[]

  @@map("tags")
}

model ArticleTag {
  articlePath  String   @map("article_path")
  tagId       Int      @map("tag_id")
  article     Article  @relation(fields: [articlePath], references: [path], onDelete: Cascade)
  tag         Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articlePath, tagId])
  @@index([tagId])
  @@map("article_tags")
}

model Folder {
  id        Int      @id @default(autoincrement())
  name      String
  parentId  Int?     @map("parent_id")
  parent    Folder?  @relation("FolderToFolder", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[] @relation("FolderToFolder")
  articles  Article[]

  @@map("folders")
  @@index([parentId])
}

enum ImportStatus {
  SUCCESS
  FAILED
  PENDING
  PARTIAL
}

model ImportMetadata {
  id          Int          @id @default(autoincrement())
  articlePath String       @unique @map("file_path")
  commitHash  String       @map("commit_hash")
  importCount Int          @default(1) @map("import_count")
  createdAt   DateTime     @default(now()) @map("created_at")

  article     Article      @relation(fields: [articlePath], references: [path], onDelete: Cascade)
  gitImport   GitImportLog? @relation(fields: [commitHash], references: [commitHash])

  @@map("import_metadata")
  @@index([commitHash])
}

model GitImportLog {
  id            Int              @id @default(autoincrement())
  commitHash    String           @unique @map("commit_hash")
  importedAt    DateTime         @default(now()) @map("imported_at")
  error         String?
  filesAdded    Int              @default(0) @map("files_added")
  filesDeleted  Int              @default(0) @map("files_deleted")
  filesModified Int              @default(0) @map("files_modified")
  foldersAdded  Int              @default(0) @map("folders_added")
  foldersDeleted Int             @default(0) @map("folders_deleted")
  tagsAdded     Int              @default(0) @map("tags_added")
  tagsDeleted   Int              @default(0) @map("tags_deleted")
  metadata      Json             @default("{}")
  status        ImportStatus     @default(SUCCESS)
  imports       ImportMetadata[]

  @@map("git_import_logs")
  @@index([commitHash])
  @@index([commitHash, status])
} 