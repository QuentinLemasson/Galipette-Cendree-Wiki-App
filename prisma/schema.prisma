generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
  directUrl = env("DB_URL")
  relationMode = "foreignKeys"
}

model Article {
  id              Int       @id @default(autoincrement())
  title           String
  preview         String?   @db.VarChar(500)
  path            String    @unique
  metadata        Json      @default("{}")
  folderId        Int?      @map("folder_id")
  folder          Folder?   @relation(fields: [folderId], references: [id])
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  relatedToArticles   ArticleRelation[] @relation("ArticleToRelated")
  relatedFromArticles ArticleRelation[] @relation("RelatedToArticle")
  tags                ArticleTag[]
  importMetadata      ImportMetadata?
  content             ArticleContent?

  @@map("articles")
  @@index([path, title])
  @@index([folderId])
}

model ArticleContent {
  id          Int     @id @default(autoincrement())
  content     String  @db.Text
  articleId   Int     @unique @map("article_id")
  article     Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@map("article_contents")
} 

model ArticleRelation {
  id          Int      @id @default(autoincrement())
  articleFromId   Int      @map("article_from_id")
  articleToId   Int      @map("article_to_id")
  
  articleFrom     Article  @relation("ArticleToRelated", fields: [articleFromId], references: [id], onDelete: Cascade)
  articleTo     Article  @relation("RelatedToArticle", fields: [articleToId], references: [id], onDelete: Cascade)

  @@unique([articleFromId, articleToId])
  @@index([articleFromId])
  @@index([articleToId])
  @@map("article_relations")
}

model Tag {
  id           Int          @id @default(autoincrement())
  name         String       @unique
  articles     ArticleTag[]

  @@map("tags")
}

model ArticleTag {
  articleId   Int      @map("article_id")
  tagId       Int      @map("tag_id")
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag         Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
  @@index([articleId])
  @@map("article_tags")
}

model Folder {
  id        Int      @id @default(autoincrement())
  name      String
  parentId  Int?     @map("parent_id")
  parent    Folder?  @relation("FolderToFolder", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[] @relation("FolderToFolder")
  articles  Article[]

  @@map("folders")
  @@index([parentId])
}

enum ImportStatus {
  SUCCESS
  FAILED
  PENDING
  PARTIAL
}

model ImportMetadata {
  id          Int          @id @default(autoincrement())
  articleId   Int          @unique @map("article_id")
  commitHash  String       @map("commit_hash")
  importCount Int          @default(1) @map("import_count")
  createdAt   DateTime     @default(now()) @map("created_at")

  article     Article      @relation(fields: [articleId], references: [id], onDelete: Cascade)
  gitImport   GitImportLog? @relation(fields: [commitHash], references: [commitHash])

  @@map("import_metadata")
  @@index([commitHash])
  @@index([articleId])
}

model GitImportLog {
  id            Int              @id @default(autoincrement())
  commitHash    String           @unique @map("commit_hash")
  importedAt    DateTime         @default(now()) @map("imported_at")
  error         String?
  filesAdded    Int              @default(0) @map("files_added")
  filesDeleted  Int              @default(0) @map("files_deleted")
  filesModified Int              @default(0) @map("files_modified")
  foldersAdded  Int              @default(0) @map("folders_added")
  foldersDeleted Int             @default(0) @map("folders_deleted")
  tagsAdded     Int              @default(0) @map("tags_added")
  tagsDeleted   Int              @default(0) @map("tags_deleted")
  metadata      Json             @default("{}")
  status        ImportStatus     @default(SUCCESS)
  imports       ImportMetadata[]

  @@map("git_import_logs")
  @@index([commitHash])
  @@index([commitHash, status])
}

